# ===========================================
#  GIT QUELL-REPOSITORY
# ===========================================
# Vollständige HTTPS-URL, z. B.:
#   GitHub: https://github.com/user/thesis-de
#   GitLab: https://gitlab.com/user/thesis-de
SRC_GIT_URL=https://github.com/youruser/thesis-de
SRC_GIT_TOKEN=

# ===========================================
#  GIT ZIEL-REPOSITORY
# ===========================================
TARGET_GIT_URL=https://github.com/youruser/thesis-en
TARGET_GIT_TOKEN=

# ===========================================
#  GIT-VERHALTEN
# ===========================================
GIT_BRANCH=main
GIT_AUTHOR_NAME=GitTranslate Bot
GIT_AUTHOR_EMAIL=bot@gittranslate.local

# ===========================================
#  LLM (Ollama)
# ===========================================
# Ohne Docker: http://localhost:11434
# Mit Docker:  http://host.docker.internal:11434
LLM_API_URL=http://localhost:11434
LLM_MODEL=translategemma:4b
LLM_TIMEOUT=120

# ===========================================
#  ÜBERSETZUNG
# ===========================================
SOURCE_LANG=German
TARGET_LANG=English

# ===========================================
#  WEBHOOK-SICHERHEIT
# ===========================================
# Optionales HMAC-Geheimnis — denselben Wert in den Webhook-Einstellungen des Git-Anbieters setzen
WEBHOOK_SECRET=

# ===========================================
#  SYNC / POLLING
# ===========================================
# Intervall in Sekunden für automatisches Polling (0 = deaktiviert, POST /sync manuell nutzen)
POLL_INTERVAL=0

# ===========================================
#  WORKER
# ===========================================
WORKER_PORT=8000
LOG_LEVEL=INFO
# Verzeichnis für State-Persistenz (für Ohne-Docker-Betrieb z. B. ./state setzen)
STATE_DIR=/app/state
